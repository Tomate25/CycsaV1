      "unidad": "in",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "modulo_ruptura_fuera_psi",
      "expresion": "3*{carga_lbf}*{dist_fractura_prom}/({ancho_prom}*{espesor_prom}^2)",
      "descripcion": "MR fuera del tercio medio (exceso ≤ 5 % de L): R = 3Pa/bd²",
      "unidad": "lbf/in²",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "modulo_ruptura_kgcm2",
      "expresion": "{modulo_ruptura_psi}/14.2",
      "descripcion": "MR",
      "unidad": "kg/cm²",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    }
