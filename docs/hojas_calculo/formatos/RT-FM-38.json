    },
    {
      "codigo": "modulo_ruptura_psi",
      "expresion": "{carga_lbf}*{luz_apoyos}/({ancho_prom}*{espesor_prom}^2)",
      "descripcion": "MR, fractura en tercio medio: R = PL/bd²",
      "unidad": "lbf/in²",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "dist_fractura_prom",
      "expresion": "({dist_fractura_1}+{dist_fractura_2}+{dist_fractura_3})/3",
