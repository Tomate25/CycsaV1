    {
      "codigo": "absorcion_lbft3",
      "expresion": "({masa_saturada}-{masa_seca})/({masa_saturada}-{masa_sumergida})*62.4",
      "descripcion": "Absorción",
      "unidad": "lb/ft³",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "absorcion_kgm3",
      "expresion": "({masa_saturada}-{masa_seca})/({masa_saturada}-{masa_sumergida})*1000",
      "descripcion": "Absorción",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "absorcion_pct",
      "expresion": "({masa_saturada}-{masa_seca})*100/{masa_seca}",
      "descripcion": "Absorción",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "humedad_pct_absorcion",
      "expresion": "({masa_recibida}-{masa_seca})*100/({masa_saturada}-{masa_seca})",
      "descripcion": "Humedad como % de la absorción total",
      "unidad": "%",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "densidad_seca",
      "expresion": "{masa_seca}/({masa_saturada}-{masa_sumergida})*1000",
      "descripcion": "Densidad seca",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "volumen_neto",
      "expresion": "({masa_saturada}-{masa_sumergida})*1000",
      "descripcion": "Volumen neto",
      "unidad": "cm³",
      "redondeo": null,
      "por_especimen": true
    },
    {
      "codigo": "area_neta",
      "expresion": "{volumen_neto}/{alto}",
