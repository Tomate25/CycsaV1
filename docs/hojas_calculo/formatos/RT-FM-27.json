      "codigo": "energia",
      "expresion": "{golpes}*{capas}*{masa_piston}*{altura_caida}/{volumen_molde}",
      "descripcion": "Energía de compactación",
      "unidad": "kg·cm/cm³",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "humedad",
      "expresion": "({tara_suelo_humedo}-{tara_suelo_seco})*100/({tara_suelo_seco}-{tara})",
      "descripcion": "Humedad del punto",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "densidad_seca",
      "expresion": "(({masa_molde_suelo}-{masa_molde})/{volumen_molde})/(1+{humedad}/100)*1000",
      "descripcion": "Peso volumétrico seco del punto",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    }
