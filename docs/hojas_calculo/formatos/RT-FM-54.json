  "formulas": [
    {
      "codigo": "vol_pozo",
      "expresion": "{vol_agua_total}-{vol_agua_anillo}",
      "descripcion": "Volumen del pozo",
      "unidad": "L",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "densidad_humeda",
      "expresion": "{peso_excavado}/{vol_pozo}*1000",
      "descripcion": "Peso volumétrico húmedo",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "humedad",
      "expresion": "({rec_humedo}-{rec_seco})*100/({rec_seco}-{recipiente})",
      "descripcion": "Humedad",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": false
    },
    {
      "codigo": "densidad_seca",
      "expresion": "{densidad_humeda}/(1+{humedad}/100)",
      "descripcion": "Peso volumétrico seco",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "compactacion",
      "expresion": "{densidad_seca}*100/{pvs_maximo}",
      "descripcion": "Grado de compactación",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": false
    }
  ],
