      "unidad": "cm",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "largo_prom",
      "expresion": "({largo_1}+{largo_2})/2",
      "descripcion": "Longitud promedio",
      "unidad": "cm",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "relacion_ld",
      "expresion": "{largo_prom}/{diametro_prom}",
      "descripcion": "Relación L/D",
      "unidad": null,
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "factor_ld",
      "expresion": "1-CEIL(MAX(0,MIN(1,1.75-{relacion_ld})))*(1-({ld_a}*{relacion_ld}^3+{ld_b}*{relacion_ld}^2+{ld_c}*{relacion_ld}+{ld_d}))",
      "descripcion": "Factor L/D: 1 si L/D ≥ 1.75; polinomio si L/D < 1.75 (C39). Sin IF: CEIL(MAX(0,MIN(1,1.75−L/D))) vale 1 o 0",
      "unidad": null,
      "redondeo": "ROUND(x,3)",
      "por_especimen": false
    },
    {
      "codigo": "area_1_cm2",
      "expresion": "PI()*{diametro_1}^2/4",
      "descripcion": "Área con diámetro 1",
      "unidad": "cm²",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "area_2_cm2",
      "expresion": "PI()*{diametro_2}^2/4",
      "descripcion": "Área con diámetro 2",
      "unidad": "cm²",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "area_cm2",
      "expresion": "({area_1_cm2}+{area_2_cm2})/2",
      "descripcion": "Área promedio",
      "unidad": "cm²",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "area_in2",
      "expresion": "{area_cm2}/6.4516",
      "descripcion": "Área",
      "unidad": "in²",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "volumen_cm3",
      "expresion": "({area_1_cm2}*{largo_1}+{area_2_cm2}*{largo_2})/2",
      "descripcion": "Volumen promedio",
      "unidad": "cm³",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "densidad",
      "expresion": "({masa_kg}*1000000/({area_1_cm2}*{largo_1})+{masa_kg}*1000000/({area_2_cm2}*{largo_2}))/2",
      "descripcion": "Densidad",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "carga_real_lbf",
      "expresion": "{prensa_a_e14}*({lectura_carga_lbf}/100000)^3*10+{prensa_b_e8}*({lectura_carga_lbf}/10000)^2+{prensa_c}*{lectura_carga_lbf}+{prensa_d}",
      "descripcion": "Carga corregida por calibración (polinomio cúbico con coeficientes escalados)",
      "unidad": "lbf",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "carga_real_kg",
      "expresion": "{carga_real_lbf}/2.2046",
      "descripcion": "Carga",
      "unidad": "kg",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "esfuerzo_psi",
      "expresion": "{carga_real_lbf}*{factor_ld}/{area_in2}",
      "descripcion": "Resistencia a compresión → roturas.esfuerzo_psi",
      "unidad": "lbf/in²",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "esfuerzo_psi_reportado",
      "expresion": "ROUND({esfuerzo_psi}/10,0)*10",
      "descripcion": "Resistencia redondeada a 10 psi",
      "unidad": "lbf/in²",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "esfuerzo_kgcm2",
      "expresion": "{esfuerzo_psi_reportado}/14.2",
      "descripcion": "Resistencia → roturas.esfuerzo_kgcm2",
      "unidad": "kg/cm²",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "porcentaje_fc",
      "expresion": "{esfuerzo_psi_reportado}*100/{resistencia_diseno_psi}",
      "descripcion": "% de f'c → roturas.porcentaje_fc",
