  "formulas": [
    {
      "codigo": "humedad_antes",
      "expresion": "({tara_humedo_antes}-{tara_seco_antes})*100/({tara_seco_antes}-{tara_antes})",
      "descripcion": "Humedad de moldeo",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "humedad_sat",
      "expresion": "({tara_humedo_sat}-{tara_seco_sat})*100/({tara_seco_sat}-{tara_sat})",
      "descripcion": "Humedad tras saturación",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "densidad_humeda",
      "expresion": "({masa_molde_suelo}-{masa_molde})/{volumen_molde}*1000",
      "descripcion": "Densidad húmeda",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "densidad_seca",
      "expresion": "{densidad_humeda}*100/(100+{humedad_antes})",
      "descripcion": "Densidad seca",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "compactacion",
      "expresion": "{densidad_seca}*100/{pvs_maximo}",
      "descripcion": "Compactación reproducida",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "densidad_seca_sat",
      "expresion": "({masa_molde_suelo_sat}-{masa_molde})/{volumen_molde}*1000*100/(100+{humedad_sat})",
      "descripcion": "Densidad seca saturada",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "esfuerzo_01",
      "expresion": "{lectura_01}*{constante_anillo}/{area_piston}",
      "descripcion": "Esfuerzo a 0.1 in",
      "unidad": "psi",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "esfuerzo_02",
      "expresion": "{lectura_02}*{constante_anillo}/{area_piston}",
      "descripcion": "Esfuerzo a 0.2 in",
      "unidad": "psi",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "cbr_01",
      "expresion": "{esfuerzo_01}/1000*100",
      "descripcion": "CBR a 0.1 in (patrón 1000 psi)",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "cbr_02",
      "expresion": "{esfuerzo_02}/1500*100",
      "descripcion": "CBR a 0.2 in (patrón 1500 psi)",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    },
    {
      "codigo": "cbr",
