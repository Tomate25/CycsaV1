    },
    {
      "codigo": "arena_en_hoyo",
      "expresion": "{arena_empleada}-{factor_cono}-{arena_sobrante}",
      "descripcion": "Arena en la excavación",
      "unidad": "g",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "volumen_hoyo",
      "expresion": "{arena_en_hoyo}/{pu_arena}",
      "descripcion": "Volumen de excavación",
      "unidad": "L",
      "redondeo": "ROUND(x,4)",
      "por_especimen": false
    },
    {
      "codigo": "densidad_humeda",
      "expresion": "{masa_excavada}/{volumen_hoyo}",
      "descripcion": "P.V.H. in situ",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "humedad",
      "expresion": "({rec_humedo}-{rec_seco})*100/({rec_seco}-{recipiente})",
      "descripcion": "Humedad",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": false
    },
    {
      "codigo": "densidad_seca",
      "expresion": "{densidad_humeda}*100/({humedad}+100)",
      "descripcion": "P.V.S. in situ",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "compactacion",
      "expresion": "{densidad_seca}*100/{pvs_maximo}",
      "descripcion": "% compactación",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": false
    }
  ],
