    {
      "codigo": "area_neta_cm2",
      "expresion": "{largo_prom}*{ancho_prom}+2*(({base_mayor_prom}+{base_menor_prom})/2)*{altura_prom}",
      "descripcion": "Área neta según columnas D/E (sin /2) — DUDOSA",
      "unidad": "cm²",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "area_neta_in2",
      "expresion": "{area_neta_cm2}/6.45",
      "descripcion": "Área neta",
      "unidad": "in²",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "carga_prom",
      "expresion": "({carga_1}+{carga_2}+{carga_3})/3",
      "descripcion": "Carga promedio",
      "unidad": "lbf",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "resistencia_psi",
      "expresion": "{carga_prom}/{area_neta_in2}*{factor_acabado}",
      "descripcion": "Resistencia",
      "unidad": "lbf/in²",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "resistencia_kgcm2",
      "expresion": "{resistencia_psi}/14.2",
      "descripcion": "Resistencia",
      "unidad": "kg/cm²",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    },
    {
      "codigo": "absorcion_kgm3",
      "expresion": "({masa_saturada}-{masa_seca})/({masa_saturada}-{masa_sumergida})*1000",
      "descripcion": "Absorción",
      "unidad": "kg/m³",
      "redondeo": "ROUND(x,0)",
      "por_especimen": true
    },
    {
      "codigo": "absorcion_pct",
      "expresion": "({masa_saturada}-{masa_seca})*100/{masa_seca}",
      "descripcion": "Absorción",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": true
    }
