  "formulas": [
    {
      "codigo": "humedad",
      "expresion": "({masa_humeda_tara}-{masa_seca_tara})*100/({masa_seca_tara}-{tara})",
      "descripcion": "Contenido de humedad base seca (D2216)",
      "unidad": "%",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "humedad_correccion",
      "expresion": "({masa_humeda_tara}-{masa_seca_tara})*100/({masa_humeda_tara}-{tara})",
      "descripcion": "Humedad base húmeda (corrección de masa)",
      "unidad": "%",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "masa_seca",
      "expresion": "{masa_seca_tara}-{tara}",
      "descripcion": "Masa seca inicial",
      "unidad": "g",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "perdida_lavado",
      "expresion": "{masa_seca_tara}-{masa_lavada_tara}",
      "descripcion": "Pérdida por lavado",
      "unidad": "g",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "total_retenido",
      "expresion": "{perdida_lavado}+{ret_2in}+{ret_1_1_2in}+{ret_1in}+{ret_3_4in}+{ret_1_2in}+{ret_3_8in}+{ret_no4}+{ret_no8}+{ret_no10}+{ret_no16}+{ret_no20}+{ret_no30}+{ret_no40}+{ret_no50}+{ret_no60}+{ret_no80}+{ret_no100}+{ret_no140}+{ret_no200}+{ret_fondo}",
      "descripcion": "Pérdida por lavado + suma de retenidos",
      "unidad": "g",
      "redondeo": null,
      "por_especimen": false
    },
    {
      "codigo": "perdida_proceso",
      "expresion": "100-{total_retenido}*100/{masa_seca}",
      "descripcion": "Pérdida en el proceso de tamizado",
      "unidad": "%",
      "redondeo": "ROUND(x,2)",
      "por_especimen": false
    },
    {
      "codigo": "pasa_no200",
      "expresion": "({perdida_lavado}+{ret_fondo})*100/{masa_seca}",
      "descripcion": "% que pasa No. 200 (lavado + fondo)",
      "unidad": "%",
      "redondeo": "ROUND(x,1)",
      "por_especimen": false
    },
    {
      "codigo": "ip",
      "expresion": "{ll}-{lp}",
      "descripcion": "Índice de plasticidad",
      "unidad": "%",
      "redondeo": "ROUND(x,0)",
      "por_especimen": false
    }
  ],
  "agregaciones": [
    {
      "codigo": "curva_granulometrica",
      "funcion": "acumulado",
      "de": "ret_*",
      "descripcion": "% retenido acumulado y % que pasa = 100 − acumulado·100/masa_seca por tamiz (servicio PHP; no cabe en una expresión)",
      "unidad": "%"
    },
    {
      "codigo": "clasificacion_sucs",
      "funcion": "clasificar_sucs",
      "de": "curva_granulometrica, ll, ip",
      "descripcion": "D2487 con catalogos/listas.json → sucs"
    }
  ],
  "criterios_aceptacion": [
