  debe               Decimal           @default(0.00) @db.Decimal(14, 2)
  haber              Decimal           @default(0.00) @db.Decimal(14, 2)
  partidas_diario    partidas_diario   @relation(fields: [id_partida], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "partidas_diario_detalles_ibfk_1")
  cuentas_contables  cuentas_contables @relation(fields: [id_cuenta_contable], references: [id], onUpdate: Restrict, map: "partidas_diario_detalles_ibfk_2")

  @@index([id_cuenta_contable], map: "id_cuenta_contable")
  @@index([id_partida], map: "id_partida")
}

model productos {
  id                     Int                   @id @default(autoincrement())
  no_item                String?               @db.VarChar(50)
  formato_id             Int?
  tipo_muestra           String?               @db.VarChar(100)
  matriz_tipo            String?               @db.VarChar(100)
  tipo_muestreo          String?               @db.VarChar(100)
  ensayo_servicio        String?               @db.Text
  nombre_comercial       String?               @db.VarChar(255)
  condiciones_muestra    String?               @db.Text
  codigo_servicio        String?               @db.VarChar(100)
  estatus                String?               @default("No acreditado") @db.VarChar(50)
  norma_astm             String?               @db.VarChar(255)
  procedimiento_muestreo String?               @db.VarChar(255)
  codigo_hoja_campo      String?               @db.VarChar(100)
  unidad_medida          String?               @db.VarChar(50)
  precio                 Decimal               @default(0.00) @db.Decimal(10, 2)
  observaciones          String?               @db.VarChar(255)
  activo                 Boolean?              @default(true)
  fecha_creacion         DateTime              @default(now()) @db.Timestamp(0)
  fecha_actualizacion    DateTime              @default(now()) @db.Timestamp(0)
  cotizacion_detalles    cotizacion_detalles[]
  ensayos_parametros     ensayos_parametros[]
  formatos_ensayos       formatos_ensayos?     @relation(fields: [formato_id], references: [id], onUpdate: Restrict, map: "fk_productos_formatos")

  @@index([formato_id], map: "fk_productos_formatos")
}

model recepcion_muestras {
  id                Int                             @id @default(autoincrement())
  id_os             Int
  correlativo_anual Int
  anio              Int
  tipo_muestra      recepcion_muestras_tipo_muestra @default(Laboratorio)
  codigo_muestra    String                          @unique(map: "codigo_muestra") @db.VarChar(50)
  id_cilindro       String?                         @db.VarChar(100)
  is_qa_qc          Boolean                         @default(false)
  replica_codigo    String?                         @db.VarChar(20)
  is_sealed         Boolean                         @default(true)
  codigo_campo      String                          @db.VarChar(50)
  fecha_recepcion   DateTime                        @db.DateTime(0)
  recibido_por      Int
  entregado_por     String?                         @db.VarChar(150)
  observaciones     String?                         @db.Text
  estado            recepcion_muestras_estado?      @default(Registrado)
  lotes_muestras    lotes_muestras[]
  ordenes_servicio  ordenes_servicio                @relation(fields: [id_os], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "recepcion_muestras_ibfk_1")
  usuarios          usuarios                        @relation(fields: [recibido_por], references: [id], onUpdate: Restrict, map: "recepcion_muestras_ibfk_2")

  @@index([id_os], map: "id_os")
  @@index([recibido_por], map: "recibido_por")
}

model roles {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique(map: "nombre") @db.VarChar(50)
  descripcion String?    @db.VarChar(255)
  permisos    String?    @db.Text
  creado_en   DateTime   @default(now()) @db.Timestamp(0)
  usuarios    usuarios[]
}

model secuencias_muestras {
  anio               Int
  tipo_muestra       secuencias_muestras_tipo_muestra
  ultimo_correlativo Int                              @default(0)

  @@id([anio, tipo_muestra])
}

model tecnicos {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(150)
  activo         Boolean? @default(true)
  fecha_registro DateTime @default(now()) @db.Timestamp(0)
}

model usuarios {
  id                                                       Int                  @id @default(autoincrement())
  id_rol                                                   Int
  nombre                                                   String               @db.VarChar(100)
  email                                                    String               @unique(map: "email") @db.VarChar(150)
  password                                                 String               @db.VarChar(255)
  reset_token                                              String?              @db.VarChar(255)
  reset_token_expires_at                                   DateTime?            @db.DateTime(0)
  activo                                                   Boolean?             @default(true)
  permisos                                                 String?              @db.Text
  creado_en                                                DateTime             @default(now()) @db.Timestamp(0)
  actualizado_en                                           DateTime             @default(now()) @db.Timestamp(0)
  session_id                                               String?              @db.VarChar(255)
  intentos_fallidos                                        Int?                 @default(0)
  bloqueado                                                Int?                 @default(0) @db.TinyInt
  debe_cambiar_password                                    Int?                 @default(0) @db.TinyInt
  bitacora                                                 bitacora[]
  cotizaciones_cotizaciones_id_usuario_creadorTousuarios   cotizaciones[]       @relation("cotizaciones_id_usuario_creadorTousuarios")
  cotizaciones_cotizaciones_id_usuario_revisorTousuarios   cotizaciones[]       @relation("cotizaciones_id_usuario_revisorTousuarios")
  ensayo_edades                                            ensayo_edades[]
  informes_control_informes_control_revisado_porTousuarios informes_control[]   @relation("informes_control_revisado_porTousuarios")
  informes_control_informes_control_aprobado_porTousuarios informes_control[]   @relation("informes_control_aprobado_porTousuarios")
  recepcion_muestras                                       recepcion_muestras[]
  roles                                                    roles                @relation(fields: [id_rol], references: [id], onUpdate: Restrict, map: "usuarios_ibfk_1")

  @@index([id_rol], map: "id_rol")
}

model vehiculos {
  id             Int      @id @default(autoincrement())
  placa          String   @unique(map: "placa") @db.VarChar(50)
  marca          String?  @db.VarChar(100)
  modelo         String?  @db.VarChar(100)
  activo         Boolean? @default(true)
  fecha_registro DateTime @default(now()) @db.Timestamp(0)
}

