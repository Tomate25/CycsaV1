generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:@localhost:3306/cycsa_db"
}

model bancos_cuentas {
  id                   Int                    @id @default(autoincrement())
  id_cuenta_contable   Int?
  banco_nombre         String                 @db.VarChar(150)
  numero_cuenta        String                 @db.VarChar(100)
  moneda               String                 @default("C$") @db.VarChar(10)
  saldo_inicial        Decimal                @default(0.00) @db.Decimal(14, 2)
  saldo_actual         Decimal                @default(0.00) @db.Decimal(14, 2)
  activo               Boolean?               @default(true)
  fecha_registro       DateTime               @default(now()) @db.Timestamp(0)
  cuentas_contables    cuentas_contables?     @relation(fields: [id_cuenta_contable], references: [id], map: "fk_bancos_cuenta_contable")
  bancos_transacciones bancos_transacciones[]

  @@index([id_cuenta_contable], map: "fk_bancos_cuenta_contable")
}

model bancos_transacciones {
  id               Int                                   @id @default(autoincrement())
  id_banco_cuenta  Int
  tipo_transaccion bancos_transacciones_tipo_transaccion
  numero_documento String?                               @db.VarChar(100)
  beneficiario     String?                               @db.VarChar(255)
  monto            Decimal                               @db.Decimal(14, 2)
  fecha            DateTime                              @db.Date
  estado           bancos_transacciones_estado           @default(Emitido)
  descripcion      String?                               @db.Text
  fecha_registro   DateTime                              @default(now()) @db.Timestamp(0)
  bancos_cuentas   bancos_cuentas                        @relation(fields: [id_banco_cuenta], references: [id], onDelete: Cascade, map: "fk_transacciones_banco")

  @@index([id_banco_cuenta], map: "fk_transacciones_banco")
}

model bitacora {
  id             Int       @id @default(autoincrement())
  id_usuario     Int?
  usuario_nombre String    @db.VarChar(150)
  modulo         String    @db.VarChar(100)
  accion         String    @db.VarChar(100)
  descripcion    String    @db.Text
  id_referencia  Int?
  ip             String    @db.VarChar(45)
  fecha_creacion DateTime  @default(now()) @db.Timestamp(0)
  usuarios       usuarios? @relation(fields: [id_usuario], references: [id], onUpdate: Restrict, map: "bitacora_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

