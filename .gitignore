# Variables de entorno locales (NO subir a git; .env contiene las credenciales base de Bluehost)
.env.local
.env.testing

# Scripts de prueba sueltos y volcados SQL con datos sensibles
prueba.php
cycsa_db_backup.sql
database/cycsa_*.sql
database/backups/

# Carpetas de desarrollo temporal y respaldos
scratch/
*.zip
database/backups/*.sql

# Ejecutables y utilidades temporales
cloudflared.exe
*.bat

# Almacenamiento interno de logs y temporales (conservar carpetas con .gitkeep)
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/pdf/*
!storage/pdf/.gitkeep
storage/temp/*
!storage/temp/.gitkeep
almacenamiento/logs/*
!almacenamiento/logs/.gitkeep
almacenamiento/cache/*
!almacenamiento/cache/.gitkeep
almacenamiento/solicitudes/*
!almacenamiento/solicitudes/.gitkeep
almacenamiento/informes/*
!almacenamiento/informes/.gitkeep

# Archivos subidos por clientes/usuarios (evitar fuga de información en git)
publico/uploads/*
!publico/uploads/.htaccess
!publico/uploads/**/.gitkeep

# Archivos del sistema operativo y herramientas
.DS_Store
Thumbs.db
.phpunit.result.cache
