# Variables de entorno locales (NO subir a git; .env contiene las credenciales base de Bluehost)
.env.local

# Dependencias de Composer
vendor/

# Carpetas de desarrollo temporal y respaldos
scratch/
*.zip
database/backups/*.sql

# Ejecutables y utilidades temporales
cloudflared.exe
*.bat

# Almacenamiento interno de logs y temporales
storage/logs/*
storage/cache/*
storage/pdf/*
storage/temp/*
almacenamiento/logs/*
almacenamiento/cache/*

# Archivos subidos por clientes/usuarios (evitar fuga de información en git)
publico/uploads/*
!publico/uploads/.htaccess
!publico/uploads/**/.gitkeep

# Archivos del sistema operativo y herramientas
.DS_Store
Thumbs.db
.phpunit.result.cache
